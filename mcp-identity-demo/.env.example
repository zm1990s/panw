# Portkey 配置
PORTKEY_API_KEY=pk-xxxxxxxxxxxxxxxx

# MCP Server 配置
# 直连本地 server
MCP_SERVER_URL=http://localhost:8000/mcp

# 或通过 Portkey Gateway（下面两个变量分别对应场景2和场景3）
PORTKEY_MCP_URL_CLAIMS=https://mcp.portkey.ai/identity-demo-mcp/mcp
PORTKEY_MCP_URL_AUTH0=https://mcp.portkey.ai/identity-demo-mcp-oauth/mcp
PORTKEY_MCP_URL_EXCHANGE=http://mcp.portkey.ai/identity-demo-mcp-exchange/mcp

# Auth0 配置（可选，用于 IdP 集成测试）
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_AUDIENCE=your_api_audience
AUTH0_MCP_AUDIENCE=https://mcp-server/    # Auth0 里为 MCP Server 注册的 API identifier


# Auth0 Access Token（通过 client_credentials 获取）
AUTH0_ACCESS_TOKEN=eyJ...
