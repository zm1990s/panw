# Agent + MCP Identity Demo

# Layer 1: OIDC Provider (Auth0 / CyberArk / Okta ...)
OIDC_DOMAIN=your-tenant.auth0.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_AUDIENCE=https://identity-demo-api
OIDC_CALLBACK_URL=http://localhost:3000/callback
# OIDC_DISCOVERY_URL 默认从 OIDC_DOMAIN 推导；使用 CyberArk 等非 Auth0 Provider 时手动指定
# OIDC_DISCOVERY_URL=https://{tenant}.id.cyberark.cloud/oidc/.well-known/openid-configuration

# Layer 2: Portkey
PORTKEY_API_KEY=pk-your-portkey-api-key
PORTKEY_MCP_URL=https://mcp.portkey.ai/identity-demo/mcp
PORTKEY_LLM_URL=https://api.portkey.ai/v1/chat/completions
PORTKEY_LLM_MODEL=gpt-4o

# Layer 3: MCP Server
API_BASE_URL=http://localhost:8080
MCP_BASE_URL=http://localhost:8000   # /.well-known/mcp 里对外暴露的 MCP 端点前缀
INTERNAL_API_KEY=<openssl rand -hex 32>
# X-User-Claims 来源校验开关（默认 true）
# 设为 false 可跳过 Portkey Gateway 强制校验，直连调试时使用
# REQUIRE_PORTKEY_CLAIMS=false
# MCP OAuth 2.1（RFC 8414）
# IDIRA 注册时会 GET /.well-known/oauth-authorization-server 自动发现认证方式
# 配置后：MCP Server 暴露标准 well-known 端点，并对每次工具调用做 Bearer token JWKS 验签
# 不配置：well-known 返回 {"auth_method": "none"}，工具调用不验 token
# MCP_OAUTH_DISCOVERY_URL=https://{tenant}.id.cyberark.cloud/oidc/.well-known/openid-configuration
# MCP_OAUTH_AUDIENCE=        # 可选；留空则跳过 aud 校验
# REQUIRE_OAUTH=true          # 设为 false 可降级为警告（调试用）

# Layer 4: Business API (复用 Auth0 配置)
# REQUIRE_API_OAUTH=false  # 关闭时跳过所有认证，工具调用以匿名公开用户身份执行，只返回 public 文档
# DEFAULT_ROLE=admin        # 测试用：强制覆盖所有用户的 role（admin/member/readonly/guest），留空则从 JWT claims 读取
