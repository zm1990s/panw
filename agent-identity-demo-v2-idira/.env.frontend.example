# 前端服务配置（agent-web）
# 复制为 .env.frontend 并填入真实值

# Layer 1: SSO / OIDC Provider
OIDC_DOMAIN=your-tenant.auth0.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_AUDIENCE=https://identity-demo-api
OIDC_CALLBACK_URL=https://your-frontend-domain.com/callback
# 使用 CyberArk 等非 Auth0 Provider 时手动指定 Discovery URL
# OIDC_DISCOVERY_URL=https://{tenant}.id.cyberark.cloud/oidc/.well-known/openid-configuration

# Layer 2: Portkey（通过 Portkey 云端中转连接后端 MCP）
PORTKEY_API_KEY=pk-your-portkey-api-key
PORTKEY_MCP_URL=https://mcp.portkey.ai/identity-demo/mcp
PORTKEY_LLM_URL=https://api.portkey.ai/v1/chat/completions
PORTKEY_LLM_MODEL=gpt-4o

# Layer 2 (替代方案): IDIRA Identity Broker
# 配置后自动启用，SSO 登录时会自动链式完成 IDIRA 授权（同一 CyberArk 租户静默完成）
# IDIRA_CLIENT_ID=       从 IDIRA 控制台 "Register AI Agent (Custom)" 获取
# IDIRA_CLIENT_SECRET=   可选
# IDIRA_AUTHORIZE_URL=   IDIRA OAuth Authorize 端点
# IDIRA_TOKEN_URL=        IDIRA OAuth Token 端点
# IDIRA_CALLBACK_URL=https://your-frontend-domain.com/callback/idira  # 专用路由，须与 IDIRA 控制台注册值精确一致
# IDIRA_OAUTH_SCOPE=openid full
# IDIRA_TOKEN_FILE=/tmp/idira_token.json
# IDIRA_MCP_URL=https://pachina.data.aigw.cyberark.cloud/mcp/identity-demo-mcp  # CyberArk AI Gateway MCP 端点
